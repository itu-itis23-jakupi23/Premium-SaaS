{
  "name": "workspace",
  "version": "0.0.0",
  "packageManager": "pnpm@10.24.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node -e \"const fs=require('fs'); for (const f of ['package-lock.json','yarn.lock']) { try { fs.rmSync(f,{force:true}); } catch {} } const ua=process.env.npm_config_user_agent||''; if (ua && !ua.startsWith('pnpm/')) { console.error('Use pnpm instead'); process.exit(1); }\"",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "db:generate": "pnpm --filter @workspace/db run generate",
    "db:migrate": "pnpm --filter @workspace/db run migrate",
    "db:push": "pnpm --filter @workspace/db run push",
    "db:repair:critical": "node scripts/repair-critical-schema.mjs",
    "db:seed": "pnpm --filter @workspace/db run seed",
    "db:clean-test-data": "node scripts/clean-test-data.mjs",
    "db:check-journal": "node scripts/check-migration-journal.mjs",
    "db:reconcile-journal": "node scripts/reconcile-migration-journal.mjs",
    "db:verify-migrations": "node scripts/verify-database-migrations.mjs",
    "db:verify-backup": "node scripts/verify-backup-restore.mjs",
    "storage:verify-restart": "node scripts/verify-upload-restart.mjs",
    "db:studio": "pnpm --filter @workspace/db run studio",
    "e2e": "pnpm --filter @workspace/ens-landing run e2e",
    "e2e:release": "node scripts/run-playwright-release.mjs",
    "lint": "eslint artifacts/api-server/src artifacts/ens-landing/src scripts --max-warnings 0",
    "security:audit": "pnpm audit --prod --audit-level high",
    "security:secrets": "node scripts/scan-secrets.mjs",
    "public:metadata": "node scripts/check-public-metadata.mjs",
    "public:routes": "node scripts/check-public-routes.mjs",
    "workspace:transform": "node scripts/check-transform-constants.mjs",
    "ui:unfinished": "node scripts/check-unfinished-controls.mjs",
    "performance:budgets": "node scripts/check-frontend-budgets.mjs",
    "deployment:preflight": "node scripts/validate-deployment.mjs && pnpm --filter @workspace/api-server run preflight:env",
    "release:check": "node scripts/release-check.mjs",
    "release:clean-room": "node scripts/verify-clean-room.mjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"@workspace/*\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.66.0"
  }
}
