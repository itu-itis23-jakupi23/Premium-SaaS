VITE_PORTAL=staff
VITE_API_BASE_URL=http://localhost:5000/api
VITE_USE_MOCK_API=false
# Company access code — staff must enter this before reaching the login page.
# Change this to a strong, secret passphrase before deploying.
VITE_STAFF_ACCESS_CODE=change-me-before-deploy

# ── Server-side config (not exposed to the browser) ───────────────────────────

# Port the Express API server listens on (default: 5000)
PORT=5000

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Standard connection string — works with every managed Postgres provider.
#
# Local Docker:
#   DATABASE_URL=postgresql://postgres:password@localhost:5432/ens_agency
#
# Neon (recommended — free serverless Postgres, production-ready):
#   Sign up at https://neon.tech → create a project → copy the connection string
#   DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/ens_agency?sslmode=require
#
# Supabase:
#   DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
#
# Railway / Render / Fly.io: paste the DATABASE_URL from the database dashboard
#
DATABASE_URL=postgresql://postgres:password@localhost:5432/ens_agency

# Set to "false" only for local Postgres without SSL (e.g. Docker).
# Leave unset or "true" for all managed cloud providers.
DATABASE_SSL=false

# ── Email (Resend) ─────────────────────────────────────────────────────────────

# Public URL of your deployed app — used to build invitation links in emails.
APP_URL=http://localhost:5173

# Resend transactional email API key — https://resend.com (free: 3 000 emails/month)
RESEND_API_KEY=your-resend-api-key-here

# Verified sender address (must match a domain you verified in Resend).
RESEND_FROM=ENS Agency <onboarding@resend.dev>
