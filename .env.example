DATABASE_URL=postgres://ens_app:ens_dev_password@localhost:5432/ens
AUTH_SECRET=replace-with-a-long-random-secret
MESSAGE_ENCRYPTION_KEY=replace-with-a-separate-long-random-secret
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175
DEFAULT_ORGANIZATION_SLUG=ens-demo-agency
VITE_ORGANIZATION_SLUG=ens-demo-agency
VITE_API_BASE_URL=http://localhost:5000/api
PORT=5000
NODE_ENV=development

# Staff/chief self-signup setup key (required in production, optional in dev)
STAFF_SIGNUP_KEY=replace-with-a-long-random-secret

# File storage for documents/uploads. "local" writes to ./data/documents (dev only).
STORAGE_PROVIDER=local
DOCUMENT_STORAGE_DIR=./data/documents

# Stripe billing (workspace revision plans). Leave unset to use the simulation
# checkout fallback in dev/staging — no real payment is processed without these.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_UNLIMITED=
APP_URL=http://localhost:5173

# Resend transactional email (https://resend.com, free: 3 000 emails/month)
# Leave unset to skip email delivery (logs a notice instead of throwing).
RESEND_API_KEY=
RESEND_FROM=ENS Agency <no-reply@yourdomain.com>
