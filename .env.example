# Premium SaaS environment example
# Copy to .env for local development, or map these values in your production host.
# Never commit real secrets.

# Runtime
NODE_ENV=development
# Set to production in a real deployment. The local Compose stack sets local.
DEPLOYMENT_ENV=development
PORT=5000
APP_URL=http://localhost:5174
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175
# Set this to the exact number of reverse-proxy hops in production. Keep false
# when the API is reached directly during local development.
TRUST_PROXY=false
# Where the browser sends API calls.
#
# Behind the bundled nginx, this must be same-origin - "/api" - because nginx
# proxies that path to the API. An absolute cross-origin URL is refused by the
# enforced Content-Security-Policy (connect-src 'self'), and points browsers at
# a host they cannot reach anyway. The value below is the local development
# default, where the API runs on its own port.
VITE_API_BASE_URL=http://localhost:5000/api
VITE_ORGANIZATION_SLUG=ens-demo-agency
DEFAULT_ORGANIZATION_SLUG=ens-demo-agency

# Database
DATABASE_URL=postgres://ens_app:change-this-password@localhost:5432/premium_saas
POSTGRES_DB=premium_saas
POSTGRES_USER=ens_app
POSTGRES_PASSWORD=change-this-password

# Auth and staff access
# Generate with: openssl rand -base64 64
AUTH_SECRET=change-me-before-deploy
STAFF_SIGNUP_KEY=change-me-before-deploy

# Cookies
# Use false for local HTTP. Use true for real HTTPS production.
COOKIE_SECURE=false

# Message encryption
# Keep this stable forever. Rotating it without a migration makes old messages unreadable.
# Preferred format: base64:<32-byte-base64-value>
# Generate with: openssl rand -base64 32
MESSAGE_ENCRYPTION_KEY=change-me-before-deploy

# Durable upload storage
# Docker compose maps /app/data to the ens_api_data volume.
# For real multi-server/cloud production, replace local disk with object storage later.
STORAGE_PROVIDER=local
DOCUMENT_STORAGE_DIR=./data/documents
MESSAGE_ATTACHMENT_DIR=./data/message-attachments
WORKSPACE_ASSET_DIR=./data/workspace-assets

# API limits
API_JSON_LIMIT=75mb

# Resend transactional email
RESEND_API_KEY=
RESEND_FROM=ENS Agency <no-reply@yourdomain.com>

# Stripe billing
# Leave blank only if billing is disabled. If STRIPE_SECRET_KEY is set,
# STRIPE_WEBHOOK_SECRET must also be set for idempotent webhook processing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_UNLIMITED=

# Demo data
# Keep false for real portals.
SEED_DEMO_DATA=false

# ── Error monitoring (OP-02) ──────────────────────────────────────────────────
# Both are optional. Unset, errors are still written to the structured log but
# are not delivered anywhere, and the API logs a warning at startup. Production
# deployments should set them.
#
# Collector endpoint for backend errors (5xx responses, uncaught exceptions,
# unhandled rejections). Any URL accepting a JSON POST: Sentry, a Slack
# incoming webhook, or an internal collector.
ERROR_WEBHOOK_URL=

# Collector endpoint for frontend errors (React error boundaries, window
# onerror, unhandled promise rejections). Sent with sendBeacon where available.
VITE_ERROR_REPORT_URL=

# ── Object storage (required when STORAGE_PROVIDER=s3) ────────────────────────
# STORAGE_PROVIDER above selects local disk or S3. With s3, the API refuses to
# boot unless STORAGE_BUCKET is set - the rest have working defaults.
STORAGE_BUCKET=
# Set for S3-compatible providers (Cloudflare R2, MinIO, Backblaze). Leaving it
# blank targets AWS S3 itself. Any value here also switches on path-style URLs.
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Lifetime of a signed download link, in seconds. Default 3600 (one hour).
STORAGE_URL_EXPIRY_SECONDS=3600

# ── Staff signup keys ─────────────────────────────────────────────────────────
# STAFF_SIGNUP_KEY is the name to prefer. These two are read as fallbacks, in
# this order, and exist for older deployments - set one key, not three.
CHIEF_BOOTSTRAP_KEY=
STAFF_ACCESS_CODE=

# ── Demo and preview flags — every one of these must be off in production ─────
# Enables the demo login shortcut. Anything other than "true" disables it.
ENABLE_DEMO_ACCESS=false
# Seeds the dev backend's file store with sample projects and clients.
ENABLE_DEMO_SEED=false
# Reveals controls that are not finished yet. Implied by a dev build, so it only
# matters for a production build you want to preview internally.
VITE_SHOW_UNFINISHED=false

# ── Background workers ────────────────────────────────────────────────────────
# Both workers run by default; set to "false" to disable one. The intervals are
# in milliseconds, default one hour, and are clamped to a five-minute floor.
AUTOMATION_SWEEPS=true
AUTOMATION_SWEEP_INTERVAL_MS=3600000
TASK_REMINDER_WORKER=true
TASK_REMINDER_INTERVAL_MS=3600000
# How long a review sits before it counts as stalled. Default 3, minimum 1.
REVIEW_STALL_DAYS=3

# ── Connection and logging ────────────────────────────────────────────────────
# SSL is on unless this is exactly "false". Only turn it off for a local
# database that does not speak TLS.
DATABASE_SSL=true
# trace | debug | info | warn | error. Default info.
LOG_LEVEL=info

# ── Portal cross-links ────────────────────────────────────────────────────────
# Where the staff portal points people at the client portal. This falls back to
# a localhost URL, so leaving it unset in production hands staff broken links.
VITE_CLIENT_APP_URL=

# ── Organisation naming ───────────────────────────────────────────────────────
# Shown where an agency name is needed and none is on the record. DEFAULT_AGENCY_NAME
# wins if both are set; the fallback is "ENS Demo Agency", which you do not want
# appearing in front of a real client.
DEFAULT_AGENCY_NAME=
DEFAULT_ORGANIZATION_NAME=
